{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "willfletcher-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Run the Worker first only so www can redirect to the apex.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "willfletcher.me", "custom_domain": true },
    { "pattern": "www.willfletcher.me", "custom_domain": true }
  ]
}
